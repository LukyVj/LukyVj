@scene {
  sphere#big;
  torus#ring;
  sphere#moon;
  sphere#white;
  sphere#orange;
}

scene {
  background: BG;
  floor: BG;
  fog: BG 9 15;
  shadows: soft;
  light: -40deg 58deg;
  ambient: AMB;
  camera-angle: 0deg 14deg;
  camera-distance: 8;
  camera-target: -0.7 1.2 0;
}

#big {
  translate: 2.7 1.3 0;
  radius: 0.9;
  color: #b5cc1c;
  material: jelly(0.35);
  animation: bob 3.2s ease-in-out alternate;
}
#ring {
  translate: 2.7 1.3 0;
  rotate-x: 16deg;
  rotate-z: -14deg;
  radius: 1.35;
  thickness: 0.045;
  color: #ecebe4;
  animation: ringbob 3.2s ease-in-out alternate;
}
#moon {
  radius: 0.2;
  color: #4f7dff;
  material: jelly(0.5);
  animation: orbit 6.4s linear;
}
#white {
  translate: 4.6 2.1 -0.8;
  radius: 0.42;
  color: #ecebe4;
  animation: bob2 1.6s ease-in-out alternate;
}
#orange {
  translate: 4.7 0.6 0.7;
  radius: 0.3;
  color: #ff5a36;
  material: jelly(0.6);
  animation: bob3 3.2s ease-in-out alternate;
  animation-delay: -1.6s;
}

@keyframes bob  { from { translate: 2.7 1.2 0; } to { translate: 2.7 1.5 0; } }
@keyframes ringbob { from { translate: 2.7 1.2 0; rotate-z: -18deg; } to { translate: 2.7 1.5 0; rotate-z: -10deg; } }
@keyframes bob2 { from { translate: 4.6 2.0 -0.8; } to { translate: 4.6 2.3 -0.8; } }
@keyframes bob3 { from { translate: 4.7 0.45 0.7; } to { translate: 4.7 0.8 0.7; } }
@keyframes orbit {
  0.000% { translate: 4.450 1.554 0.000; }
  4.167% { translate: 4.390 1.642 0.453; }
  8.333% { translate: 4.216 1.706 0.875; }
  12.500% { translate: 3.937 1.742 1.237; }
  16.667% { translate: 3.575 1.749 1.516; }
  20.833% { translate: 3.153 1.725 1.690; }
  25.000% { translate: 2.700 1.671 1.750; }
  29.167% { translate: 2.247 1.593 1.690; }
  33.333% { translate: 1.825 1.495 1.516; }
  37.500% { translate: 1.463 1.383 1.237; }
  41.667% { translate: 1.184 1.266 0.875; }
  45.833% { translate: 1.010 1.151 0.453; }
  50.000% { translate: 0.950 1.046 0.000; }
  54.167% { translate: 1.010 0.958 -0.453; }
  58.333% { translate: 1.184 0.894 -0.875; }
  62.500% { translate: 1.463 0.858 -1.237; }
  66.667% { translate: 1.825 0.851 -1.516; }
  70.833% { translate: 2.247 0.875 -1.690; }
  75.000% { translate: 2.700 0.929 -1.750; }
  79.167% { translate: 3.153 1.007 -1.690; }
  83.333% { translate: 3.575 1.105 -1.516; }
  87.500% { translate: 3.937 1.217 -1.237; }
  91.667% { translate: 4.216 1.334 -0.875; }
  95.833% { translate: 4.390 1.449 -0.453; }
  100.000% { translate: 4.450 1.554 -0.000; }
}
